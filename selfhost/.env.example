# ╔══════════════════════════════════════════════════════════════════╗
# ║  CDE CIC Self-Host - Viettel Cloud Configuration              ║
# ║  Copy this file to .env and fill in real values                ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── SITE ─────────────────────────────────────────────────────────
SITE_URL=https://cde.cic.com.vn
API_EXTERNAL_URL=https://cde.cic.com.vn
ADDITIONAL_REDIRECT_URLS=

# ── POSTGRES ─────────────────────────────────────────────────────
POSTGRES_PASSWORD=your-super-secret-postgres-password-here

# ── JWT (generate with: openssl rand -base64 64) ────────────────
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
JWT_EXPIRY=900
ANON_KEY=your-generated-anon-key
SERVICE_ROLE_KEY=your-generated-service-role-key

# ── REALTIME ─────────────────────────────────────────────────────
SECRET_KEY_BASE=your-secret-key-base-at-least-64-chars
DB_ENC_KEY=supaborealencrkey

# ── VIETTEL OBJECT STORAGE (S3-compatible) ───────────────────────
VIETTEL_S3_ENDPOINT=https://objectstorage.viettelcloud.vn
VIETTEL_S3_ACCESS_KEY=your-viettel-access-key
VIETTEL_S3_SECRET_KEY=your-viettel-secret-key
VIETTEL_S3_BUCKET=cde-documents
VIETTEL_STORAGE_REGION=hn

# ── SMTP (for auth emails) ──────────────────────────────────────
SMTP_HOST=smtp.your-domain.vn
SMTP_PORT=587
SMTP_USER=noreply@your-domain.vn
SMTP_PASS=your-smtp-password
SMTP_ADMIN_EMAIL=admin@cic.com.vn
SMTP_SENDER_NAME=CDE CIC Platform

# ── GEMINI AI (for BIM AI Assistant) ────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── KONG ─────────────────────────────────────────────────────────
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# ── SIGNUP ───────────────────────────────────────────────────────
DISABLE_SIGNUP=true

# ── FRONTEND ────────────────────────────────────────────────────
FRONTEND_DIST=./dist
