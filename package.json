{
  "name": "qa-bim",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --dir apps/desktop dev",
    "desktop": "pnpm --dir apps/desktop tauri dev",
    "desktop:attach": "cargo run -p qabim-desktop",
    "build": "pnpm --dir apps/desktop build",
    "core": "cargo run -p qabim-host --bin qabim-local",
    "mcp": "cargo run -q -p qabim-mcp",
    "fixtures": "python scripts/create_fixtures.py",
    "test:geometry": "node --experimental-strip-types scripts/verify_geometry.mjs",
    "test:federation": "python scripts/verify_federation.py",
    "benchmark": "python scripts/benchmark_loading.py",
    "test:worker": "python -m pytest workers/bim/tests -q",
    "test:core": "cargo test -p qabim-application",
    "test:jobs": "python scripts/verify_import_jobs.py"
  },
  "packageManager": "pnpm@10.28.0"
}
